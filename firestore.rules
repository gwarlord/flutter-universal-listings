rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow access to all subcollections (e.g., thread) under chatChannels
    match /chatChannels/{channelId}/{subCollection=**} {
      allow read, write: if isSignedIn();
    }

    // Allow access to all subcollections under chat_channels (snake_case variant)
    match /chat_channels/{channelId}/{subCollection=**} {
      allow read, write: if isSignedIn();
    }
    
    // Catch-all for chat-related collections to ensure access during migration
    match /chats/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /channels/{document=**} {
      allow read, write: if isSignedIn();
    }

    // NEW: Allow chatChannels for new chat UI
    match /chatChannels/{document=**} {
      allow read, write: if isSignedIn();
    }
    
    match /social_feeds/{document=**} {
      allow read, write: if isSignedIn();
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
              (exists(/databases/$(database)/documents/admins/admins) &&
               request.auth.uid in get(/databases/$(database)/documents/admins/admins).data.adminUserIds));
    }

    function canEditListingFreshnessExempt() {
      return isAdmin() ||
        (resource.data.freshness == null && request.resource.data.freshness == null) ||
        (resource.data.freshness == null && request.resource.data.freshness.exempt == false) ||
        (request.resource.data.freshness.exempt == resource.data.freshness.exempt);
    }

    function canEditUserFreshnessExempt() {
      return isAdmin() ||
        (request.auth.token.serviceAccount == true) ||
        (resource.data.listingFreshnessExempt == null && request.resource.data.listingFreshnessExempt == false) ||
        (request.resource.data.listingFreshnessExempt == resource.data.listingFreshnessExempt);
    }

    function hasActiveSubscription() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let tier = userDoc.subscriptionTier;
      // Check for professional or premium (case-insensitive)
      return tier == 'professional' || tier == 'Professional' || tier == 'PROFESSIONAL' ||
             tier == 'premium' || tier == 'Premium' || tier == 'PREMIUM';
    }

    function hasActiveListingForAdCreate() {
      // Validate the referenced listing exists and belongs to the signed-in user.
      // "Active" check is based on listing freshness not being hidden when present.
      let listingId = request.resource.data.listingId;
      let listingPath = /databases/$(database)/documents/listings/$(listingId);
      return listingId is string &&
        listingId.size() > 0 &&
        exists(listingPath) &&
        get(listingPath).data.authorID == request.auth.uid &&
        (
          get(listingPath).data.freshness == null ||
          get(listingPath).data.freshness.status != 'HIDDEN'
        );
    }

    // DEAL ADS collection
    match /deal_ads/{adId} {
      allow create: if isSignedIn() && hasActiveSubscription() && hasActiveListingForAdCreate();
      allow update: if isSignedIn() && (request.auth.uid == resource.data.authorID || isAdmin());
      allow read: if true;
      allow delete: if isAdmin();
      
      match /redemptions/{userId} {
        // Allow users to read their own redemption documents
        allow read: if isSignedIn() && request.auth.uid == userId;
        // Allow users to create/update their own redemption documents
        allow create, update: if isSignedIn() && request.auth.uid == userId;
        // Allow deal author and admins to read all redemptions
        allow read: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/deal_ads/$(adId)).data.authorID ||
          isAdmin()
        );
        allow delete: if false; // Never delete redemption records (audit trail)
      }
    }
    
    // Enhancement Quotas (AI Photo Enhancement)
    match /enhancement_quotas/{listingId} {
      // Allow read if:
      // 1. User is listing author
      // 2. User is an active collaborator
      // 3. Admin
      allow read: if isSignedIn() && (
        request.auth.uid == get(/databases/$(database)/documents/listings/$(listingId)).data.authorID ||
        (exists(/databases/$(database)/documents/listings/$(listingId)/collaborators/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/listings/$(listingId)/collaborators/$(request.auth.uid)).data.isActive == true) ||
        isAdmin()
      );

      // Allow create/update by Cloud Functions only
      // (Cloud Functions enforces subscription tier, quota limits, etc.)
      allow create, update: if request.auth.token.serviceAccount == true || isAdmin();
      allow delete: if false; // Never delete quotas (audit trail)
    }

    // User Enhancement Quotas (Per-User Monthly Quotas)
    match /user_enhancement_quotas/{userId} {
      // Allow users to read and update their own quota document
      allow read, create, update: if isSignedIn() && request.auth.uid == userId;
      // Allow admins full access
      allow read, write: if isAdmin();
      // Never delete quota records (audit trail)
      allow delete: if false;
    }

    // Deal Ad Quotas (Per-User Monthly Ad Posting Quotas)
    match /deal_ad_quotas/{userId} {
      // Allow users to read and update their own quota document
      allow read, create, update: if isSignedIn() && request.auth.uid == userId;
      // Allow admins full access
      allow read, write: if isAdmin();
      // Never delete quota records (audit trail)
      allow delete: if false;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if (isOwner(userId) || isAdmin() || (isSignedIn() && request.auth.token.serviceAccount == true))
        && canEditUserFreshnessExempt();
      allow delete: if isAdmin();
      
      match /myBookings/{bookingId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.customerId;
        allow update, delete: if isSignedIn() && (
          request.auth.uid == resource.data.customerId ||
          request.auth.uid == resource.data.listingAuthorId ||
          isAdmin()
        );
      }
      
      match /receivedBookings/{bookingId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isSignedIn();
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }
      
      match /savedDeals/{dealId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId);
      }

      match /clients/{clientId} {
        allow read, write: if isOwner(userId);
      }

      match /quotes/{quoteId} {
        allow read, write: if isOwner(userId);
      }

      match /invoices/{invoiceId} {
        allow read, write: if isOwner(userId);
      }

      match /counters/{counterId} {
        allow read, write: if isOwner(userId);
      }
      
      // Assigned Listings (Lister Collaboration)
      // Quick lookup for collaborators to see which listings they're assigned to
      match /assignedListings/{listingId} {
        allow read: if isOwner(userId) || isAdmin();
        // Writes only via Cloud Functions (when collaborator is added/removed)
        allow write: if false;
      }

      // Attention/Badges subcollection for tracking unread counts
      match /attention/{subDoc=**} {
        allow read: if isOwner(userId) || isAdmin();
        // Cloud Functions can write (server-side updates)
        // Users cannot write directly to prevent tampering
        allow write: if request.auth.token.serviceAccount == true || isAdmin();
      }

      // Entitlements/Subscription subcollection
      match /entitlements/{entitlementId} {
        allow read: if isOwner(userId) || isAdmin();
        // Cloud Functions can write (server-side subscription updates)
        allow write: if request.auth.token.serviceAccount == true || isAdmin();
      }

      // Payment Details - Private Profile (owner only)
      match /payment_details/profile {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if isSignedIn() && request.auth.uid == userId;
      }

      // Payment Details - Public Snapshot (authenticated read)
      match /payment_details/public {
        allow read: if isSignedIn();
        allow write: if (isSignedIn() && request.auth.uid == userId) || isAdmin() || request.auth.token.serviceAccount == true;
      }
    }

    match /public_docs/{token} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.type in ['quote', 'invoice'];
      allow update, delete: if request.auth.token.serviceAccount == true ||
        (isSignedIn() && request.auth.uid == resource.data.ownerUid);
    }
    
    // Listings collection
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.authorID;
      
      // Allow update if:
      // 1. User is the author
      // 2. User is an admin
      // 3. User is ONLY incrementing the viewCount (allows public view tracking)
      // 4. User is ONLY updating reviewsCount and reviewsSum (allows review posting)
      // NOTE: tapCount and tapBadge are managed by Cloud Functions only
        allow update: if isSignedIn() && (
          request.auth.uid == resource.data.authorID ||
          request.auth.uid == resource.data.customerId ||
          isAdmin() ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewsCount', 'reviewsSum']))
        ) && 
        // Prevent client-side modification of tap fields (Cloud Functions only)
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['tapCount', 'tapBadge']) || isAdmin()) &&
        // Allow authors/admins to update even if freshness structure is missing
        (request.auth.uid == resource.data.authorID || isAdmin() || canEditListingFreshnessExempt());
      
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.authorID || isAdmin());
      
      match /bookings/{bookingId} {
          allow read: if isSignedIn() && (request.auth.uid == resource.data.customerId || request.auth.uid == get(/databases/$(database)/documents/listings/$(listingId)).data.authorID || isAdmin());
          allow create: if isSignedIn() && request.auth.uid == request.resource.data.customerId;
          allow update: if isSignedIn() && (
            request.auth.uid == get(/databases/$(database)/documents/listings/$(listingId)).data.authorID ||
            request.auth.uid == resource.data.customerId ||
            isAdmin()
          );
          allow delete: if isSignedIn() && (request.auth.uid == resource.data.customerId || request.auth.uid == get(/databases/$(database)/documents/listings/$(listingId)).data.authorID || isAdmin());
          
          // Proof of Payment (POP) - allows submission and review updates
          // POP is stored directly in booking document (proofOfPayment field)
          // Customers can upload/submit their own POP
          // Listers and collaborators can review/update POP status
      }
      
      // Taps (Vouching) subcollection
      match /taps/{userId} {
        // Authenticated users can read taps
        allow read: if request.auth != null;
        
        // Users can create their own tap document
        // Must be authenticated, cannot tap own listing, must set correct userId
        allow create: if isSignedIn() && 
                        request.auth.uid == userId && 
                        request.auth.uid != get(/databases/$(database)/documents/listings/$(listingId)).data.authorID &&
                        request.resource.data.userId == request.auth.uid &&
                        request.resource.data.listingId == listingId;
        
        // Users can delete only their own tap
        allow delete: if isSignedIn() && request.auth.uid == userId;
        
        // No updates allowed (delete and recreate instead)
        allow update: if false;
      }
      
      // Catalog Items (Mini Store - Premium Feature)
      match /catalog_items/{itemId} {
        // Allow read if:
        // 1. User is the listing author (can always read their own catalog)
        // OR
        // 2. Listing is public (storeEnabled=true, storeMode includes internal_catalog, listerTierSnapshot=premium)
        allow read: if (isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/listings/$(listingId)).data.authorID) ||
          (get(/databases/$(database)/documents/listings/$(listingId)).data.storeEnabled == true &&
           (get(/databases/$(database)/documents/listings/$(listingId)).data.storeMode == 'internal_catalog' ||
            get(/databases/$(database)/documents/listings/$(listingId)).data.storeMode == 'both') &&
           get(/databases/$(database)/documents/listings/$(listingId)).data.listerTierSnapshot == 'premium');
        
        // Allow write ONLY if:
        // 1. User is authenticated and is the listing author
        // 2. App-side service validates Premium tier and store config
        // (Database rules trust app-side validation to avoid complex nested checks)
        allow create, update, delete: if isSignedIn() &&
          request.auth.uid == get(/databases/$(database)/documents/listings/$(listingId)).data.authorID;
      }

      // Rental Catalog Items (Premium Rentals)
      match /rental_catalog/{itemId} {
        // Allow read if:
        // 1. User is the listing author
        // OR
        // 2. Rentals are enabled for the listing
        allow read: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/listings/$(listingId)).data.authorID ||
          get(/databases/$(database)/documents/listings/$(listingId)).data.rentalConfig.isRentalEnabled == true
        );

        // Allow write ONLY if listing author
        allow create, update, delete: if isSignedIn() &&
          request.auth.uid == get(/databases/$(database)/documents/listings/$(listingId)).data.authorID;
      }

      // Rental Units (Premium Rentals)
      match /rental_units/{unitId} {
        // Allow read for all signed-in users (needed for viewing booking details)
        allow read: if isSignedIn();

        // Allow write ONLY if listing author
        allow create, update, delete: if isSignedIn() &&
          request.auth.uid == get(/databases/$(database)/documents/listings/$(listingId)).data.authorID;
      }

      // Collaborators subcollection (Lister Collaboration)
      match /collaborators/{collaboratorUid} {
        // Allow list/query if:
        // 1. User is listing author (can see all collaborators)
        // 2. User is an active collaborator (can see team members)
        // 3. Admin
        allow list: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/listings/$(listingId)).data.authorID ||
          (exists(/databases/$(database)/documents/listings/$(listingId)/collaborators/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/listings/$(listingId)/collaborators/$(request.auth.uid)).data.isActive == true) ||
          isAdmin()
        );

        // Allow get (single document read) if:
        // 1. User is listing author
        // 2. User is the collaborator themselves
        // 3. User is an active collaborator (can see other team members)
        // 4. Admin
        allow get: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/listings/$(listingId)).data.authorID ||
          request.auth.uid == collaboratorUid ||
          (exists(/databases/$(database)/documents/listings/$(listingId)/collaborators/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/listings/$(listingId)/collaborators/$(request.auth.uid)).data.isActive == true) ||
          isAdmin()
        );

        // NEVER allow direct client-side writes to collaborator documents
        // All writes must go through Cloud Functions only
        allow create, update, delete: if false;
      }

      // Activity log subcollection
      match /activity/{activityId} {
        // Allow read if:
        // 1. User is listing author
        // 2. User is an active collaborator (can see activity in listings they collaborate on)
        // 3. Admin
        allow read: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/listings/$(listingId)).data.authorID ||
          (exists(/databases/$(database)/documents/listings/$(listingId)/collaborators/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/listings/$(listingId)/collaborators/$(request.auth.uid)).data.isActive == true) ||
          isAdmin()
        );

        // NEVER allow client-side writes (Cloud Functions only)
        allow create, update, delete: if false;
      }

      // Image Variants (AI Photo Enhancement)
      match /image_variants/{variantId} {
        // Allow read/list if:
        // 1. User is the listing author (can view all variants)
        // 2. User is an active collaborator
        // 3. Admin
        allow read, list: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/listings/$(listingId)).data.authorID ||
          (exists(/databases/$(database)/documents/listings/$(listingId)/collaborators/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/listings/$(listingId)/collaborators/$(request.auth.uid)).data.isActive == true) ||
          isAdmin()
        );

        // Allow create if listing author (Cloud Functions will validate subscription tier & quota)
        allow create: if isSignedIn() && 
          request.auth.uid == get(/databases/$(database)/documents/listings/$(listingId)).data.authorID;

        // Allow update if listing author or active collaborator (for publishing/rating variants)
        allow update: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/listings/$(listingId)).data.authorID ||
          (exists(/databases/$(database)/documents/listings/$(listingId)/collaborators/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/listings/$(listingId)/collaborators/$(request.auth.uid)).data.isActive == true)
        );

        // Allow delete if listing author only (can't delete other's variants)
        allow delete: if isSignedIn() && 
          request.auth.uid == get(/databases/$(database)/documents/listings/$(listingId)).data.authorID;
      }

      // Activity Tracking - Customer engagement tracking
      match /activities/{activityId} {
        // Customers can write activities (record their own engagement)
        allow create: if isSignedIn() && 
          request.resource.data.customerId == request.auth.uid;
        
        // Listing author and admins can read activity data
        allow read: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/listings/$(listingId)).data.authorID ||
          isAdmin()
        );
        
        // Cloud functions and admins can update
        allow update: if request.auth.token.serviceAccount == true || isAdmin();
        
        // No deletes except by admins (preserve activity history)
        allow delete: if isAdmin();
      }

      // Activity Score - Cached aggregated activity (read-only for users)
      match /metadata/activity_score {
        // Listing author and admins can read activity scores
        allow read: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/listings/$(listingId)).data.authorID ||
          isAdmin()
        );
        
        // Only cloud functions can write (calculation is server-side)
        allow write: if request.auth.token.serviceAccount == true || isAdmin();
      }

      // Auto-refresh Records - Track when listings were auto-refreshed
      match /auto_refreshes/{refreshId} {
        // Listing author and admins can read
        allow read: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/listings/$(listingId)).data.authorID ||
          isAdmin()
        );
        
        // Only cloud functions can write
        allow write: if request.auth.token.serviceAccount == true || isAdmin();
        
        // No deletes except by admins
        allow delete: if isAdmin();
      }
    }
    
    // Bookings collection (top-level)
    match /bookings/{bookingId} {
      allow read: if request.auth != null && (
                  resource.data.customerId == request.auth.uid ||
                  resource.data.listersUserId == request.auth.uid ||
                  request.auth.uid == get(/databases/$(database)/documents/listings/$(resource.data.listingId)).data.authorID ||
                  isAdmin()
                );
      allow create: if request.auth != null;
      // Add other rules for update, delete as needed
    }
    
    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Filters collection
    match /filters/{filterId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.authorID;
      // Allow update by:
      // 1. Review author (can edit their own review)
      // 2. Admin (can hide/unhide reviews via moderation)
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.authorID || 
        isAdmin()
      );
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.authorID || isAdmin());
    }
    
    // Review Removal Requests collection (Review Moderation)
    match /review_removal_requests/{requestId} {
      // Allow read if:
      // 1. User is the lister who created the request
      // 2. User is an admin
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.listerId || 
        isAdmin()
      );
      
      // Allow create if:
      // 1. User is authenticated and is the lister (listerId must match auth.uid)
      // 2. Status must be 'PENDING' on creation
      allow create: if isSignedIn() && 
        request.auth.uid == request.resource.data.listerId &&
        request.resource.data.status == 'PENDING';
      
      // Allow update only by admins (for approving/rejecting requests)
      allow update: if isAdmin();
      
      // Allow delete only by admins
      allow delete: if isAdmin();
    }
    
    // Reports collection (Listing Flagging/Reporting)
    match /reports/{reportId} {
      // Allow read if:
      // 1. User is the reporter who created it
      // 2. User is an admin
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.reporterId || 
        isAdmin()
      );
      
      // Allow create if:
      // 1. User is authenticated and is the reporter (reporterId must match auth.uid)
      // 2. Status must be 'pending' on creation
      allow create: if isSignedIn() && 
        request.auth.uid == request.resource.data.reporterId &&
        request.resource.data.status == 'pending';
      
      // Allow update only by admins (for dismissing/reviewing reports)
      allow update: if isAdmin();
      
      // Allow delete only by admins
      allow delete: if isAdmin();
    }
    
    // Mail collection
    match /mail/{mailId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    
    // Admin collection
    match /admins/{document} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Admin subscription audit log
    match /admin_subscription_audit_logs/{logId} {
      // Admins can create and read audit entries
      allow create: if isAdmin() &&
        request.resource.data.action == 'edit_user_subscription';
      allow read: if isAdmin();
      // Immutable audit records from client
      allow update, delete: if false;
    }
    
    // Email verification codes
    match /email_verifications/{verificationId} {
      // Only the user can read their own verification records
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      // Cloud Functions create verification records
      allow create: if false; // Only Cloud Functions can create
      // Cloud Functions update verification records
      allow update: if false; // Only Cloud Functions can update
      allow delete: if false; // Only Cloud Functions can delete
    }
    
    // Order Requests (Mini Store - Premium Feature)
    match /order_requests/{requestId} {
      // Allow create ONLY if:
      // 1. User is authenticated and is the customer
      // 2. Listing exists, has store enabled, and lister is Premium
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.customerId &&
        get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.storeEnabled == true &&
        get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.listerTierSnapshot == 'premium';
      
      // Allow read for:
      // 1. Customer who placed the order
      // 2. Lister who owns the listing
      // 3. Admins
      // Note: Queries with where('listerId'|'customerId') + orderBy('createdAt') require a composite index
      // The index is auto-created by Firestore when you first run the query in the app
      // If permission denied persists after deploying this rule, allow 1-2 minutes for propagation
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.customerId ||
        request.auth.uid == resource.data.listerId ||
        isAdmin()
      );
      
      // Allow update by:
      // 1. Lister (managing order status: confirmed, fulfilled, declined)
      // 2. Customer (cancelling their own pending orders)
      // CRITICAL: Shipping field updates MUST go through Cloud Function for RevenueCat verification
      // This prevents direct client-side writes to shipping field
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.listerId ||
        request.auth.uid == resource.data.customerId
      ) && !hasShippingFieldChange();
      
      // No deletes allowed
      allow delete: if false;
    }
    
    // Helper function to check if shipping field is being modified
    function hasShippingFieldChange() {
      let oldShipping = resource.data.get('shipping', null);
      let newShipping = request.resource.data.get('shipping', null);
      return oldShipping != newShipping;
    }
    
    // Rental Bookings (Premium Rentals Feature)
    match /rental_bookings/{bookingId} {
      // Allow read for:
      // 1. All signed-in users (for availability checking)
      // 2. Listing owner can see all bookings for their listings
      // 3. Customer can see their own bookings
      allow read: if isSignedIn();
      
      // Allow create if user is authenticated and is the customer
      allow create: if isSignedIn() && 
        request.auth.uid == request.resource.data.customerId;
      
      // Allow update by:
      // 1. Listing owner (managing booking status: confirmed, fulfilled, cancelled)
      // 2. Customer (cancelling their own bookings)
      allow update: if isSignedIn() && (
        request.auth.uid == get(/databases/$(database)/documents/listings/$(resource.data.listingId)).data.authorID ||
        request.auth.uid == resource.data.customerId ||
        isAdmin()
      );
      
      // Allow delete by listing owner or admin
      allow delete: if isSignedIn() && (
        request.auth.uid == get(/databases/$(database)/documents/listings/$(resource.data.listingId)).data.authorID ||
        isAdmin()
      );
    }
    
    // Stripe customers
    match /stripe_customers/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
      
      match /checkout_sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }
      
      match /subscriptions/{subscriptionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // ========================================
    // COLLABORATION CHAT SCOPES
    // ========================================

    // Helper to check if collaborator is active with chat permissions
    function isActiveCollaboratorWithChatAccess(listingId) {
      let collabPath = /databases/$(database)/documents/listings/$(listingId)/collaborators/$(request.auth.uid);
      return exists(collabPath) &&
             get(collabPath).data.isActive == true &&
             get(collabPath).data.permissions.manageChats == true;
    }

    // Helper for listing management (owner or collaborator with chat permission)
    function canManageListing(listingId) {
      let listing = get(/databases/$(database)/documents/listings/$(listingId));
      return isSignedIn() && (
        request.auth.uid == listing.data.authorID ||
        isActiveCollaboratorWithChatAccess(listingId) ||
        isAdmin()
      );
    }

    // Listing Team Chat (owner + collaborators with manageChats=true)
    match /listing_chats/{listingChatId} {
      allow read: if isSignedIn() && canManageListing(resource.data.listingId);
      allow create: if isSignedIn() && canManageListing(request.resource.data.listingId);
      allow update: if isSignedIn() && canManageListing(resource.data.listingId);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && canManageListing(get(/databases/$(database)/documents/listing_chats/$(listingChatId)).data.listingId);
        allow create: if isSignedIn() && 
          request.auth.uid == request.resource.data.senderUid &&
          canManageListing(get(/databases/$(database)/documents/listing_chats/$(listingChatId)).data.listingId);
        allow update: if false;
        allow delete: if isSignedIn() && request.auth.uid == resource.data.senderUid;
      }
    }

    // Order Thread Chat (owner + collaborators with manageChats=true + order's customer)
    match /order_chats/{orderChatId} {
      allow read: if isSignedIn() && (
        canManageListing(resource.data.listingId) ||
        request.auth.uid == resource.data.customerUid
      );
      allow create: if isSignedIn() && (
        canManageListing(request.resource.data.listingId) ||
        request.auth.uid == request.resource.data.customerUid
      );
      allow update: if isSignedIn() && (
        canManageListing(resource.data.listingId) ||
        request.auth.uid == resource.data.customerUid
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          canManageListing(get(/databases/$(database)/documents/order_chats/$(orderChatId)).data.listingId) ||
          request.auth.uid == get(/databases/$(database)/documents/order_chats/$(orderChatId)).data.customerUid
        );
        allow create: if isSignedIn() && 
          request.auth.uid == request.resource.data.senderUid &&
          (
            canManageListing(get(/databases/$(database)/documents/order_chats/$(orderChatId)).data.listingId) ||
            request.auth.uid == get(/databases/$(database)/documents/order_chats/$(orderChatId)).data.customerUid
          );
        allow update: if false;
        allow delete: if isSignedIn() && request.auth.uid == resource.data.senderUid;
      }
    }

    // Events collection (CaribTap events feed)
    match /events/{eventId} {
      // Public read so events can appear in home feed for all users
      allow read: if true;

      // Authenticated users can create their own events only
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid;

      // Only event owner or admin can modify/delete
      allow update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.createdBy ||
        isAdmin()
      );
    }

    // ========================================================================
    // TABLE MODE (PREMIUM FEATURE)
    // ========================================================================

    // Tables subcollection under listings (managed via Cloud Functions)
    // Staff can read tables to generate QR codes and manage
    // Tables contain tableSecret which should not be exposed to customers
    match /listings/{listingId}/tables/{tableId} {
      // Only staff (owner + authorized collaborators) can read tables
      allow read: if isSignedIn() && canManageListing(listingId);
      // All writes via Cloud Functions (enforces premium check)
      allow write: if false;
    }

    // Table Sessions collection
    match /table_sessions/{sessionId} {
      // Customers can read their own sessions
      // Staff can read sessions for listings they manage
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.customerUid ||
        canManageListing(resource.data.listingId)
      );
      // Writes only via Cloud Functions (rate limiting, cooldown enforcement, etc.)
      allow write: if false;

      // Session events subcollection
      match /events/{eventId} {
        // Same read access as parent session
        allow read: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/table_sessions/$(sessionId)).data.customerUid ||
          canManageListing(get(/databases/$(database)/documents/table_sessions/$(sessionId)).data.listingId)
        );
        // Writes only via Cloud Functions
        allow write: if false;
      }
    }

    // ========================================================================
    // AI SEARCH COLLECTIONS
    // ========================================================================

    // Search Index Collections (read-only for clients, written by Cloud Functions)
    // NOTE: Reads allowed for authenticated users; App Check optional in debug mode
    match /search_index_listings/{docId} {
      allow read: if isSignedIn();
      allow write: if false; // Only Cloud Functions can write
    }

    match /search_index_deals/{docId} {
      allow read: if isSignedIn();
      allow write: if false; // Only Cloud Functions can write
    }

    // Query Cache (read-only for clients, written by Cloud Functions)
    // NOTE: Reads allowed for authenticated users; App Check optional in debug mode
    match /search_query_cache/{docId} {
      allow read: if isSignedIn();
      allow write: if false; // Only Cloud Functions can write
    }

    // Saved Searches (user-specific)
    match /saved_searches/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Rate Limits (user-specific read, Cloud Functions write only)
    match /search_rate_limits/{userId} {
      allow read: if isSignedIn() && userId == request.auth.uid;
      allow write: if false; // Only Cloud Functions can write
    }

    // Search Analytics (no direct client access)
    match /search_analytics/{docId} {
      allow read, write: if false;
    }

    // Search Costs (no direct client access)
    match /search_costs/{docId} {
      allow read, write: if false;
    }

    // ========================================================================
    // MULTI-LOCATION BRANDS
    // ========================================================================

    // Brands collection - for organizing multiple listings under one brand
    match /brands/{brandId} {
      // All authenticated users can read brands
      allow read: if isSignedIn();
      
      // Any authenticated user can create a brand (owned by creator)
      allow create: if isSignedIn();
      
      // Only owner or admin can update
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.ownerUid || 
        isAdmin()
      );
      
      // Only owner or admin can delete
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.ownerUid || 
        isAdmin()
      );
    }

  // Featured Requests Collection
  match /featured_requests/{requestId} {
    // Allow users to read their own requests
    allow read: if isSignedIn() && 
      resource.data.userId == request.auth.uid;
    // Allow admins to read all requests
    allow read: if isAdmin();
    // Only Cloud Functions can create/update/delete
    allow create, update, delete: if request.auth.token.serviceAccount == true || isAdmin();
  }

  // Featured Usage Collection (Track monthly usage)
  match /featured_usage/{userId} {
    // Allow users to read their own usage
    allow read: if isSignedIn() && request.auth.uid == userId;
    // Allow admins to read all usage
    allow read: if isAdmin();
    // Only Cloud Functions can write
    allow create, update, delete: if request.auth.token.serviceAccount == true || isAdmin();
  }

  // Featured Grants Collection (Monthly allocations)
  match /featured_grants/{userId} {
    // Allow users to read their own grants
    allow read: if isSignedIn() && request.auth.uid == userId;
    // Allow admins to read all grants
    allow read: if isAdmin();
    // Only Cloud Functions and admins can write
    allow create, update, delete: if request.auth.token.serviceAccount == true || isAdmin();
  }
  }
}
